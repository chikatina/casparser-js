{
  "name": "@chikatina/casparser-js",
  "version": "1.1.0",
  "description": "Reads Indian consolidated account statements (CAMS, KFintech, NSDL, CDSL) in JavaScript",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./analysis": "./src/analysis/index.js",
    "./pdf": "./src/pdf/pdfjs.js",
    "./isin-db": "./src/isin-db.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "casparser": "bin/casparser.js",
    "casparser-js": "bin/casparser.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chikatina/casparser-js.git"
  },
  "homepage": "https://github.com/chikatina/casparser-js#readme",
  "bugs": {
    "url": "https://github.com/chikatina/casparser-js/issues"
  },
  "author": "chikatina <https://github.com/chikatina>",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "bin",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "schema": "node scripts/generate-schema.js",
    "schema:check": "node scripts/generate-schema.js && git diff --exit-code schema/",
    "prepublishOnly": "npm test && npm run schema"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "keywords": [
    "cas",
    "casparser",
    "cams",
    "kfintech",
    "nsdl",
    "cdsl",
    "mutual-funds",
    "demat",
    "nps",
    "india"
  ],
  "devDependencies": {
    "pdfjs-dist": "^6.2.108"
  }
}
